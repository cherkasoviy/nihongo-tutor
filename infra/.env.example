# Copy to infra/.env on the server and fill in. Never commit the filled file.
# Generate secrets with:  openssl rand -hex 32

# --- deployment ---------------------------------------------------------------
ENV=prod
LOG_LEVEL=INFO
DOMAIN=tutor.example.com
PUBLIC_URL=https://tutor.example.com
MINIAPP_URL=https://tutor.example.com

# --- database / cache (compose wires these into the containers) ----------------
POSTGRES_USER=nihongo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nihongo
DB_URL=postgresql+asyncpg://nihongo:change-me@postgres:5432/nihongo
REDIS_URL=redis://redis:6379/0
AUDIO_DIR=/data/audio

# --- telegram -----------------------------------------------------------------
BOT_TOKEN=
WEBHOOK_SECRET=
# Comma-separated Telegram user ids that become admins on first /start
ADMIN_TG_IDS=

# --- auth ---------------------------------------------------------------------
JWT_SECRET=
JWT_TTL_SECONDS=3600
INITDATA_MAX_AGE_SECONDS=86400

# --- AI providers (Phase 2+; leave empty until needed) -------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Path to the Google service-account JSON key, mounted into the container. Off GCP there is no
# attached service account to inherit, so this must be set once TTS/STT land in Phase 2.
GOOGLE_APPLICATION_CREDENTIALS=
MODEL_STRONG=claude-opus-5
MODEL_FAST=claude-opus-5
DEFAULT_DAILY_BUDGET_USD=0.35
