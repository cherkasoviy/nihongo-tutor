# Copy to infra/.env on the server and fill in. Never commit the filled file.
# Generate secrets with:  openssl rand -hex 32

# --- deployment ---------------------------------------------------------------
ENV=prod
LOG_LEVEL=INFO
DOMAIN=tutor.example.com
PUBLIC_URL=https://tutor.example.com
MINIAPP_URL=https://tutor.example.com

# --- database / cache (compose wires these into the containers) ----------------
POSTGRES_USER=nihongo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nihongo
DB_URL=postgresql+asyncpg://nihongo:change-me@postgres:5432/nihongo
REDIS_URL=redis://redis:6379/0
AUDIO_DIR=/data/audio

# --- telegram -----------------------------------------------------------------
BOT_TOKEN=
WEBHOOK_SECRET=
# Comma-separated Telegram user ids that become admins on first /start
ADMIN_TG_IDS=

# --- auth ---------------------------------------------------------------------
JWT_SECRET=
JWT_TTL_SECONDS=3600
INITDATA_MAX_AGE_SECONDS=86400

# --- AI providers (Phase 2+; leave empty until needed) -------------------------
# Claude is reached through Vertex AI, authenticated by the service account below — set the project
# and no Anthropic key is needed anywhere. ANTHROPIC_API_KEY is only for the first-party API.
ANTHROPIC_VERTEX_PROJECT=
ANTHROPIC_VERTEX_REGION=global
ANTHROPIC_API_KEY=
# Where a refused request is retried. Vertex has no server-side fallback routing, so this is an
# explicit model rather than a policy.
ANTHROPIC_FALLBACK_MODEL=claude-opus-4-8
# On the GCP VM leave empty: google-cloud-texttospeech uses the attached service account.
GOOGLE_APPLICATION_CREDENTIALS=
MODEL_STRONG=claude-opus-5
MODEL_FAST=claude-opus-5
DEFAULT_DAILY_BUDGET_USD=0.35
